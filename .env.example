# Copy this file to ".env" and fill in your key. Never commit ".env".
GROQ_API_KEY=paste-your-groq-key-here

# Optional: force a specific Groq model, using the exact ID from console.groq.com (otherwise the best available one is picked automatically)
# LLM_MODEL=llama-3.3-70b-versatile   (see console.groq.com/settings/limits for the limits of each model)

# Optional: how many times the AI may try to repair a broken game (default 3)
# MAX_REPAIRS=3

# Optional: port for the website (default 8000)
# PORT=8000
